<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000" width="100%" height="100%" style="display:block; shape-rendering: geometricPrecision; text-rendering: geometricPrecision;">
  <defs>
    <!-- Arc for top text: TỔNG CỤC HẬU CẦN - KỸ THUẬT -->
    <path id="arcTopText" d="M 220 250 A 395 395 0 0 1 780 250" fill="none" />
    <!-- Arc for bottom text: TRƯỜNG SĨ QUAN KỸ THUẬT QUÂN SỰ/ ĐẠI HỌC TRẦN ĐẠI NGHĨA -->
    <path id="arcBottomText" d="M 125 715 A 435 435 0 0 0 875 715" fill="none" />
    <filter id="subtleGlow" x="-5%" y="-5%" width="110%" height="110%">
      <feDropShadow dx="0" dy="2" stdDeviation="3" flood-opacity="0.18" />
    </filter>
  </defs>

  <!-- Base Outline Circle -->
  <circle cx="500" cy="500" r="490" fill="#FFDE00" stroke="#00A2F0" stroke-width="12" />

  <!-- Bottom Gear / Cogwheel Teeth Segment -->
  <g fill="#FFDE00" stroke="#00A2F0" stroke-width="10" stroke-linejoin="round">
    <path d="M 230 890 L 255 940 L 305 945 L 315 905 Z" />
    <path d="M 325 915 L 355 972 L 415 978 L 428 928 Z" />
    <path d="M 445 932 L 468 990 L 532 990 L 555 932 Z" />
    <path d="M 572 928 L 585 978 L 645 972 L 675 915 Z" />
    <path d="M 685 905 L 695 945 L 745 940 L 770 890 Z" />
  </g>

  <!-- Top Blue Arc Banner (TỔNG CỤC HẬU CẦN - KỸ THUẬT) -->
  <path d="M 155 315 A 440 440 0 0 1 845 315 L 795 130 A 465 465 0 0 0 205 130 Z" fill="#008BE3" stroke="#FFDE00" stroke-width="6" />

  <!-- Top Text: TỔNG CỤC HẬU CẦN - KỸ THUẬT -->
  <text fill="#FFFFFF" font-family="'Be Vietnam Pro', 'Montserrat', 'Arial Black', sans-serif" font-weight="900" font-size="46" letter-spacing="2.5" text-anchor="middle">
    <textPath href="#arcTopText" startOffset="50%">
      TỔNG CỤC HẬU CẦN - KỸ THUẬT
    </textPath>
  </text>

  <!-- Left Rice / Wheat Laurel Ear -->
  <g fill="#FFDE00" stroke="#008BE3" stroke-width="7" stroke-linejoin="round">
    <path d="M 175 305 C 120 330 95 380 90 405 C 135 390 170 360 185 340 Z" />
    <path d="M 158 355 C 95 390 75 440 68 470 C 120 450 155 415 170 395 Z" />
    <path d="M 148 415 C 80 455 60 510 52 545 C 110 520 148 480 160 455 Z" />
    <path d="M 140 485 C 70 530 52 590 48 625 C 105 595 142 550 152 520 Z" />
    <path d="M 140 555 C 68 605 55 670 54 705 C 110 665 148 620 155 585 Z" />
    <path d="M 155 630 C 85 685 78 745 80 775 C 130 730 162 680 170 650 Z" />
    <path d="M 180 695 C 118 750 120 805 130 835 C 170 785 198 735 205 708 Z" />
    <path d="M 215 755 C 168 810 185 860 195 885 C 225 830 245 785 250 762 Z" />
  </g>

  <!-- Right Rice / Wheat Laurel Ear -->
  <g fill="#FFDE00" stroke="#008BE3" stroke-width="7" stroke-linejoin="round">
    <path d="M 825 305 C 880 330 905 380 910 405 C 865 390 830 360 815 340 Z" />
    <path d="M 842 355 C 905 390 925 440 932 470 C 880 450 845 415 830 395 Z" />
    <path d="M 852 415 C 920 455 940 510 948 545 C 890 520 852 480 840 455 Z" />
    <path d="M 860 485 C 930 530 948 590 952 625 C 895 595 858 550 848 520 Z" />
    <path d="M 860 555 C 932 605 945 670 946 705 C 890 665 852 620 845 585 Z" />
    <path d="M 845 630 C 915 685 922 745 920 775 C 870 730 838 680 830 650 Z" />
    <path d="M 820 695 C 882 750 880 805 870 835 C 830 785 802 735 795 708 Z" />
    <path d="M 785 755 C 832 810 815 860 805 885 C 775 830 755 785 750 762 Z" />
  </g>

  <!-- Center Red Circular Shield -->
  <circle cx="500" cy="500" r="360" fill="#E52320" stroke="#FFDE00" stroke-width="12" />

  <!-- Center Golden 5-pointed Star -->
  <polygon points="500,178 528,262 617,262 545,314 573,398 500,346 427,398 455,314 383,262 472,262" fill="#FFDE00" />

  <!-- Center White Technical & Academic Emblem -->
  <!-- Drafting Stand (Background legs) -->
  <g fill="#FFFFFF">
    <polygon points="465,520 480,520 322,780 300,780" opacity="0.95" />
    <polygon points="535,520 520,520 678,780 700,780" opacity="0.95" />
    <rect x="491" y="530" width="18" height="250" rx="3" opacity="0.95" />
    <polygon points="405,715 595,715 590,735 410,735" opacity="0.95" />

    <!-- Engineer Hammer Head -->
    <path d="M 395 345 L 530 345 L 534 372 L 595 388 L 595 440 L 534 440 L 530 435 L 395 435 Z" />
    
    <!-- Drafting Compass Head & Arms -->
    <circle cx="495" cy="405" r="38" fill="#E52320" stroke="#FFFFFF" stroke-width="18" />
    <polygon points="462,420 500,565 468,575 408,575" />
    <polygon points="528,420 490,565 522,575 582,575" />

    <!-- Open Book Pages (Dynamic spreading wings) -->
    <!-- Left Page Wing -->
    <path d="M 486 852 C 472 780 342 638 152 522 C 220 475 342 502 482 620 C 486 680 486 780 486 852 Z" />
    <!-- Right Page Wing -->
    <path d="M 514 852 C 528 780 658 638 848 522 C 780 475 658 502 518 620 C 514 680 514 780 514 852 Z" />
    <!-- Central Spine of the Open Book -->
    <polygon points="484,620 516,620 506,852 494,852" />
  </g>

  <!-- Bottom Yellow Ribbon Banner Structure with Red Steps and Border -->
  <g filter="url(#subtleGlow)">
    <!-- Left Ribbon Tail / Wing Fold with Red Steps -->
    <path d="M 65 715 L 148 625 L 165 735 L 95 825 L 35 765 Z" fill="#E52320" stroke="#FFDE00" stroke-width="8" stroke-linejoin="round" />
    <polygon points="52,745 88,720 102,755 66,780" fill="#FFDE00" />
    <polygon points="85,785 120,760 135,795 98,820" fill="#FFDE00" />

    <!-- Right Ribbon Tail / Wing Fold with Red Steps -->
    <path d="M 935 715 L 852 625 L 835 735 L 905 825 L 965 765 Z" fill="#E52320" stroke="#FFDE00" stroke-width="8" stroke-linejoin="round" />
    <polygon points="948,745 912,720 898,755 934,780" fill="#FFDE00" />
    <polygon points="915,785 880,760 865,795 902,820" fill="#FFDE00" />

    <!-- Main Yellow Arc Banner -->
    <path d="M 75 700 C 200 895 800 895 925 700 L 970 735 C 830 965 170 965 30 735 Z" fill="#FFDE00" stroke="#E52320" stroke-width="10" stroke-linejoin="round" />
    <path d="M 60 710 C 190 915 810 915 940 710 L 955 725 C 820 945 180 945 45 725 Z" fill="#FFDE00" />
    
    <!-- Red Accent Rim Lines on Banner -->
    <path d="M 65 720 C 200 920 800 920 935 720" fill="none" stroke="#E52320" stroke-width="6" />
    <path d="M 40 740 C 180 960 820 960 960 740" fill="none" stroke="#E52320" stroke-width="6" />
  </g>

  <!-- Bottom Banner Curved Text: TRƯỜNG SĨ QUAN KỸ THUẬT QUÂN SỰ/ ĐẠI HỌC TRẦN ĐẠI NGHĨA -->
  <text fill="#E52320" font-family="'Be Vietnam Pro', 'Montserrat', 'Arial Black', sans-serif" font-weight="900" font-size="33" letter-spacing="1.5" text-anchor="middle">
    <textPath href="#arcBottomText" startOffset="50%">
      TRƯỜNG SĨ QUAN KỸ THUẬT QUÂN SỰ/ ĐẠI HỌC TRẦN ĐẠI NGHĨA
    </textPath>
  </text>
</svg>
